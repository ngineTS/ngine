NODE_ENV=local

# Postgres
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_NAME=ngine
DB_SCHEMA=ngine

# Backend email (required — auth signing and password-recovery email will fail without these)
EMAIL_SERVICE=changeme
EMAIL_ADDRESS=changeme@example.com
EMAIL_PASSWORD=changeme

# CORS origin the backend will accept (the frontend's URL as seen by the browser).
FRONTEND_URL=http://localhost:4200

# Backend API base URL, baked into the frontend's JS bundle at build time
# (Angular environment.ts/environment.prod.ts are generated from this at `docker compose build frontend`).
API_URL=http://localhost:3000/api/

# Backend JWT auth secret key (used to sign JWTs). Change this to a long, random string in production.
JWT_SECRET=thisisafakejwtseretkey

# Stripe secret key (used to authenticate with Stripe). Change this to your own Stripe secret key in production.
STRIPE_SECRET_KEY=thisisafakestripekey
STRIPE_WEBHOOK_SECRET_KEY=thisisafakestripewebhooksecretkey
